  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "route_id": {
            "type": "string",
            "format": "uuid",
            "title": "Route Id"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "fallback_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Fallback Days",
            "default": 90
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "route_id",
          "start_date",
          "end_date"
        ],
        "title": "AnalysisRequest"
      },
      "Body_photo_api_incidents__incident_id__photo_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_photo_api_incidents__incident_id__photo_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentRequest": {
        "properties": {
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "LANDSLIDE",
              "BLOCKAGE",
              "DEBRIS",
              "OTHER"
            ],
            "title": "Kind"
          },
          "latitude": {
            "type": "number",
            "maximum": 30.0,
            "minimum": 24.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 98.0,
            "minimum": 88.0,
            "title": "Longitude"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 10,
            "title": "Description"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "route_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Id"
          },
          "segment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_id",
          "kind",
          "latitude",
          "longitude",
          "observed_at",
          "description"
        ],
        "title": "IncidentRequest"
      },
      "IncidentStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESOLVED"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 10,
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "notes"
        ],
        "title": "IncidentStatus"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "RouteRequest": {
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Destination"
          },
          "corridor_m": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 50.0,
            "title": "Corridor M",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "destination"
        ],
        "title": "RouteRequest"
