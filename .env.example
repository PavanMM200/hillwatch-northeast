DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
GOOGLE_CLOUD_PROJECT=
MAPS_BROWSER_KEY=
MAPS_ROUTES_KEY=
MAPS_APIS_ENABLED=false
MAPS_BILLING_CONFIRMED=false
MAPS_BROWSER_RESTRICTIONS=
MAPS_SERVER_RESTRICTIONS=
EE_PROJECT=
EE_AUTH_METHOD=adc
GOOGLE_APPLICATION_CREDENTIALS=
EE_SERVICE_ACCOUNT=
EE_API_ENABLED=false
EE_PROJECT_REGISTERED=false
MATLAB_METHOD=batch
MATLAB_EXECUTABLE=
MATLAB_VERSION=
