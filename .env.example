MATLAB_TIMEOUT_SECONDS=900
SCENE_LIMIT=60
MIN_COVERAGE=0.85
STALE_DAYS=14
SAR_THRESHOLD_DB=3.0
NDVI_LOSS_THRESHOLD=0.2
